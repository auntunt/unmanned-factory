<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal excerpt of the Jiangsu-standard shape, for the fidelity harness's
     self-test only. Not the full 江苏未来数据标准.xsd (1027 lines); it declares
     just the element/attribute names the synthetic sample pair uses so the
     vocabulary check has something real to check against. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="数据转换交换标准">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="清单" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="清单">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="定额" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="编号" type="xs:string"/>
      <xs:attribute name="名称" type="xs:string"/>
      <xs:attribute name="单价" type="xs:string"/>
      <xs:attribute name="合价" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="定额">
    <xs:complexType>
      <xs:attribute name="编号" type="xs:string"/>
      <xs:attribute name="名称" type="xs:string"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
