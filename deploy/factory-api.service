[Unit]
Description=webuddy 只读 JSON API（前端数据源）
# 反复重启就停手。这两个键属于 [Unit]，放 [Service] 会被静默忽略。
StartLimitIntervalSec=300
StartLimitBurst=5
After=network.target
# Caddy 反代 /api/* 到这里；它不起来时返 502，不会静默给空数据
Before=caddy.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/workspace/unmanned-factory

# 只绑 127.0.0.1。公网入口和认证都在 Caddy 层。
ExecStart=/home/ubuntu/workspace/unmanned-factory/.venv/bin/python -m factory.cli api \
    --db /home/ubuntu/factory-data/audit.db \
    --port 8788 \
    --queue /home/ubuntu/factory-data/queue

Restart=on-failure
RestartSec=5

# 比旧 dashboard 收得更紧：这个服务是纯只读的，没有 POST 表单、
# 不写 audit.db、不跑 check 探针，所以整个文件系统只读即可。
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
# 只读服务没有理由 fork 子进程
SystemCallFilter=@system-service
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=factory-api

[Install]
WantedBy=multi-user.target
