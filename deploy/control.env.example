# Copy to an operator-managed file such as /etc/unmanned-factory/control.env,
# chmod 0600, and edit there.  Do not commit credentials to this repository.
# The installer never overwrites an existing env file.

FACTORY_PUBLIC_ORIGIN=https://harness.cloudwaveai.cn
FACTORY_CONTROL_DATA=/home/ubuntu/factory-data/control
FACTORY_WORKSPACE_ROOT=/home/ubuntu/projects
FACTORY_STATIC_DIR=/home/ubuntu/workspace/unmanned-factory/frontend/dist
FACTORY_TASK_TIMEOUT=14400
FACTORY_TASK_MAX_PARALLEL=2

# Optional integrations are intentionally unset in this example.  Add their
# credentials only in the protected external env file when the integration is
# reviewed and required:
# FACTORY_GITHUB_TOKEN=
# FACTORY_WEBHOOK_SECRET=
