# NEW HOST EXAMPLE ONLY. Preserve the existing factoryweb.service on deployed hosts.
[Unit]
Description=webuddy v2 authenticated control plane
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/workspace/unmanned-factory
EnvironmentFile=/etc/unmanned-factory/control.env

# Use the installed venv directly.  uv run may resync the environment and drop
# optional provider SDKs that are required by this service.
ExecStart=/home/ubuntu/workspace/unmanned-factory/.venv/bin/factory-web serve
Restart=on-failure
RestartSec=5

# The gateway writes its control database and project worktrees.  The external
# env file is deliberately separate from this unit and is never embedded here.
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
LockPersonality=true
# SDK sandboxes may require user namespaces; verify against the installed SDK.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=factory-control

[Install]
WantedBy=multi-user.target
