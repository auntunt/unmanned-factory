# webuddy 运维维护子系统 — 环境变量示例
#
# 复制为 .env（不要提交真实值）；这里只列出变量名与用途，不包含任何密钥。
# 密钥（provider 的 API key / OAuth token）不通过环境变量传给 CLI 或子系统本身，
# 而是由已登录的 Claude Code / Codex 运行时自己持有（见 INSTALL.md「依赖」一节）。

# -- 数据域 ------------------------------------------------------------------

# control.db 所在目录（CLI 与 webuddy 服务共用同一目录即共用同一数据域）。
# 默认 ~/.factory/control
FACTORY_CONTROL_DATA=~/.factory/control

# 已登记代码库必须位于此目录之下的独立子目录；网页/CLI 都不能读取这个目录之外的文件。
# 默认 ~/projects
FACTORY_WORKSPACE_ROOT=~/projects

# -- 时区与嵌入 ----------------------------------------------------------------

# 监控总览「今天」窗口使用的时区（IANA 名称，如 Asia/Shanghai）。
# 未设置时依次回退到 TZ、/etc/localtime、进程本地时区。
FACTORY_TIMEZONE=Asia/Shanghai

# 允许 iframe 嵌入 /embed/* 的来源，空格分隔，仅接受 https:// 或本机 http://127.0.0.1|localhost。
# 默认空（不允许任何嵌入）。
FACTORY_EMBED_ORIGINS=

# -- 执行超时与预算 ------------------------------------------------------------

# 单次执行（run）允许运行的最长秒数，超时后按预算漏账熔断处理。
# 默认 14400（4 小时）
FACTORY_TASK_TIMEOUT=14400

# `repo add` 用 git URL 登记时，后台 clone 的超时秒数。
# 默认 600
FACTORY_CLONE_TIMEOUT=600

# -- 模型运行时（供已配置的执行器读取；这里只声明 provider/model，不含密钥）--------

FACTORY_PLANNER_PROVIDER=codex
FACTORY_PLANNER_MODEL=
FACTORY_CHEAP_PROVIDER=codex
FACTORY_CHEAP_MODEL=
FACTORY_STANDARD_PROVIDER=codex
FACTORY_STANDARD_MODEL=
FACTORY_STRONG_PROVIDER=codex
FACTORY_STRONG_MODEL=

# -- 仅当以 webuddy 网页服务方式接入时才需要（独立最小运行时不需要）----------------

# FACTORY_PUBLIC_ORIGIN=http://127.0.0.1:8788
# FACTORY_GITHUB_TOKEN=
# FACTORY_WEBHOOK_SECRET=
# FACTORY_STATIC_DIR=
